# Database Configuration (DB_NAME, DB_USER and DB_PASSWORD are required; there are no built-in defaults)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nafes_healthcare
DB_USER=nafes_app
DB_PASSWORD=
# Log every SQL statement (debugging only; statements may contain patient data)
DB_LOG_QUERIES=false

# Server Configuration
PORT=8001
NODE_ENV=development
# Generate a private value: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
# Self-service sign-up at POST /api/auth/register is disabled unless this is true
ENABLE_PUBLIC_REGISTRATION=false
# Required (together with NODE_ENV != production) before seed*.js may wipe and re-seed tables
ALLOW_DESTRUCTIVE_SEED=false

# CORS Configuration
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:5175

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Ollama Configuration (services/ollamaConfig.js)
# Local Ollama by default. Clinical text is sent to this host: a remote Ollama server
# must be reached over https:// (e.g. behind a TLS reverse proxy). Plain http:// is only
# accepted for loopback/private hosts unless OLLAMA_ALLOW_INSECURE_REMOTE=true.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_ALLOW_INSECURE_REMOTE=false
# Request timeout in ms for every Ollama call (generation is aborted when it expires)
OLLAMA_TIMEOUT=120000
# General medical model (AI validation, general chat, fallback for MEDBOT_MODEL)
OLLAMA_MODEL=thewindmom/llama3-med42-8b:latest
# Embedding model for RAG / medicine search (defaults to OLLAMA_MODEL when empty)
OLLAMA_EMBED_MODEL=cniongolo/biomistral
# Dimension the embedding model returns; must match the vector(N) columns (4096 in
# migrations/add_pgvector_extension.sql and create_medicines_tables.sql). Empty = not checked.
EMBEDDING_DIM=4096
# Medication information model (medbotService; defaults to OLLAMA_MODEL when empty)
MEDBOT_MODEL=Goosedev/medbot
# Chat assistant model for "drug" mode (chatService; default Goosedev/medbot)
CHAT_DRUG_MODEL=Goosedev/medbot
# Pull the models you configure, e.g.:
#   ollama pull cniongolo/biomistral
#   ollama pull Goosedev/medbot

# AI Validation Configuration
AI_VALIDATION_ENABLED=true

# Advisory AI features (services/ai, /api/ai). Master switch for language-model calls; defaults
# to false when NODE_ENV=production and true otherwise. Rule checks and SQL statistics
# (duplicate ingredients, bundle diff, analytics) do not depend on it.
AI_FEATURES_ENABLED=false
# Turn one AI feature off, e.g. the explanation of a rejected-vs-accepted bundle diff:
# AI_FEATURE_BUNDLE_DIFF_EXPLAIN=false
# AI_FEATURE_MEDICATION_SAFETY=false
# Minimum records before a statistic is shown (smaller samples return insufficientData)
AI_MIN_SAMPLE_SIZE=30

# nphies Configuration
NPHIES_ENVIRONMENT=sandbox
# NPHIES_BASE_URL is required (no default). Production MUST use HTTPS.
# The OBA sandbox is plain HTTP and is for synthetic data only; to use it set
# NPHIES_ALLOW_INSECURE_SANDBOX=true and NPHIES_BASE_URL to the sandbox URL issued to you.
NPHIES_ALLOW_INSECURE_SANDBOX=false
NPHIES_BASE_URL=
NPHIES_PRODUCTION_URL=https://hsb.nphies.sa
NPHIES_OAUTH_URL=https://hsb.nphies.sa/oauth/token

# nphies provider identity (from the nphies portal)
# Change this to your provider's NPHIES license ID
NPHIES_PROVIDER_ID=1010613708

# nphies Insurer Domain (for sandbox: sni, change for production)
NPHIES_INSURER_DOMAIN=sni

# nphies Optional Settings
NPHIES_TIMEOUT=60000
NPHIES_RETRY_ATTEMPTS=3
# Log full request/response bundles (they contain patient data; debugging only)
NPHIES_DEBUG_BUNDLES=false
