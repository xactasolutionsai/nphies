{
  "name": "nafes-backend",
  "version": "1.0.0",
  "description": "Backend API for Nafes Healthcare Management System",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node seed.js",
    "test": "node --import ./tests/setup.js --test tests/*.test.js",
    "seed-medical-knowledge": "node scripts/seedMedicalKnowledge.js",
    "import-icd10": "node scripts/importIcd10Codes.js",
    "import-medications": "node scripts/importMedicationCodes.js",
    "grant-admin": "node scripts/grantAdmin.js",
    "migrate-review": "node scripts/applyReviewMigrations.js",
    "migrate-openmed": "node scripts/migrateOpenmed.js"
  },
  "keywords": [
