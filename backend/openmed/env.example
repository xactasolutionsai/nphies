# Configure these in backend/.env alongside existing settings; never replace NPHIES settings.
# Use a NEW login belonging only to the nafes_openmed group, in the SAME application database.
# URL-encode reserved characters in the password. Never use the privileged main database login.
OPENMED_DATABASE_URL=postgresql://nafes_openmed_app:REPLACE_PRIVATE_PASSWORD@127.0.0.1:5432/nafes_healthcare
# Optional absolute Python executable. Default is backend/.venv-openmed's interpreter.
# OPENMED_PYTHON=C:/path/to/nphies/backend/.venv-openmed/Scripts/python.exe
