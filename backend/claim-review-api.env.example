# Add these to /etc/nafes/app.env with a real server-only API credential.
# Exact HTTPS Chat Completions endpoint; no query string. All three are required.
CLAIM_REVIEW_API_URL=https://api.openai.com/v1/chat/completions
CLAIM_REVIEW_API_MODEL=
CLAIM_REVIEW_API_KEY=
# For compatible providers (e.g. the configured Qwen endpoint):
# CLAIM_REVIEW_API_TOKEN_PARAMETER=max_tokens
# CLAIM_REVIEW_API_DISABLE_THINKING=true
# Restart nafes.service after configuration. Never put the key in frontend settings.
