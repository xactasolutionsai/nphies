[Unit]
Description=NAFES Healthcare API and local OpenMed advisory
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=nafes
Group=nafes
WorkingDirectory=/opt/nafes/current/backend
EnvironmentFile=/etc/nafes/app.env
Environment=HOME=/var/lib/nafes
ExecStart=/usr/local/bin/node server.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/nafes
UMask=0077
MemoryMax=6G
TasksMax=256

[Install]
WantedBy=multi-user.target
